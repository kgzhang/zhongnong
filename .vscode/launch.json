{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI: debug (single article)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli",
            "args": ["debug", "--xml", "data/xml/PMC12183824.xml"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "CLI: extract (single article, no gate)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli",
            "args": ["extract", "--xml", "data/xml/PMC12183824.xml", "--no-skip-gate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "CLI: extract with gate (single article)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli",
            "args": ["extract", "--xml", "data/xml/PMC12183824.xml", "--skip-gate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "CLI: run (all articles)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli",
            "args": ["run", "--dir", "data/xml", "--no-skip-gate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Direct: extract() call",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug_extract.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "pytest: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
