{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["doi"],
  "properties": {
    "doi": {"type": ["string", "null"]},
    "tissue_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [],
        "properties": {
          "site_name": {"type": ["string", "null"]},
          "site_category": {"type": ["string", "null"]},
          "evidence_text": {"type": ["string", "null"]},
          "source_location": {"type": ["string", "null"]}
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standard_name"],
        "properties": {
          "standard_name": {"type": ["string", "null"]},
          "abbreviation": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "indicator_category": {"type": ["string", "null"]},
          "measurement_method": {"type": ["string", "null"]},
          "measured_in": {"type": ["string", "null"]},
          "evidence_text": {"type": ["string", "null"]},
          "source_location": {"type": ["string", "null"]}
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method_name"],
        "properties": {
          "method_name": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "evidence_text": {"type": ["string", "null"]},
          "source_location": {"type": ["string", "null"]}
        }
      }
    }
  }
}
