# Knowledge Graph Extraction Pipeline — Configuration
# Copy this file and fill in your API keys

# DeepSeek API (default LLM provider)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic API (fallback / alternative provider)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default model (deepseek/deepseek-chat or deepseek/deepseek-reasoner)
LLM_MODEL=deepseek/deepseek-chat

# PubMed / NCBI Entrez (required for Stage 0 literature search)
ENTREZ_EMAIL=your-email@example.com
# ENTREZ_API_KEY=your-ncbi-api-key

# Processing
# LLM_MAX_RETRIES=2
# BATCH_SIZE=50
# MAX_CONCURRENT=12
